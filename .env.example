# Overrides for docker-compose.yml. Copy to .env and edit as needed.
# Every value here has a working default in the compose file, so .env is optional.
#
# This file configures the CONTAINER stack only. Running the API on the host
# (npm run dev) still reads server/.env — see server/.env.example.

# Database. Changing DB_PASSWORD after the first `up` requires
# `docker compose down -v`, because MySQL only reads it when initialising
# an empty data volume.
DB_PASSWORD=tms_local_dev
DB_NAME=task_management_system

# Auth. Generate a real one with:  openssl rand -hex 32
JWT_SECRET=local_dev_secret_not_for_deployment
JWT_EXPIRES_IN=8h

# Where the browser reaches the app (used for the CORS origin).
CLIENT_ORIGIN=http://localhost:4000
API_PORT=4000

# Set to false only when running the split-scheduler profile.
RUN_SCHEDULER=true

# Scoring engine
SCORING_CRON=0 2 * * *
ENGAGEMENT_RISK_THRESHOLD=40
PEER_REVIEWERS_PER_SUBMISSION=3

# Uploads. 25 MB per file is generous for the PDF/DOCX this accepts; the
# per-member quota bounds total growth.
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=10
MEMBER_STORAGE_QUOTA_MB=500

# Sessions expire after this many minutes of inactivity (SRS 5.2).
SESSION_IDLE_MINUTES=30

# Seed administrator created by db-setup
SEED_ADMIN_EMAIL=admin@tms.local
SEED_ADMIN_PASSWORD=Admin@123
